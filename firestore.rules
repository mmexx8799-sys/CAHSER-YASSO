rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Legacy read helper — kept for isActiveUser() reads (no change in read paths)
    function isActiveUser() {
      return isAuthenticated() && (!('disabled' in getUserData()) || getUserData().disabled != true);
    }

    // RBAC-2026-09 R1: single-get helpers (SR-09: one get() per helper via let)
    function hasRole(roles) {
      let u = getUserData();
      return isAuthenticated() && (!('disabled' in u) || u.disabled != true) && u.role in roles;
    }
    function isOwner() {
      return hasRole(['owner']);
    }
    function isAdmin() {
      return hasRole(['owner', 'admin']);
    }
    function isStaff() {
      return hasRole(['owner', 'admin', 'supervisor', 'cashier']);
    }
    function canOpenDay() {
      return hasRole(['owner', 'admin', 'supervisor']);
    }
    
    match /users/{userId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      // R1: owner guard + permissions field protection (SR-01/02, BR-06)
      // create: owner can create any role; admin can create non-owner; others cannot
      allow create: if isOwner() || (isAdmin() && request.resource.data.role != 'owner');
      // update: owner cannot be disabled via rules; admin cannot touch owner doc nor escalate to owner; self can update non-sensitive fields only
      allow update: if (isOwner() && !(resource.data.role == 'owner' && request.resource.data.get('disabled', false) == true))
                || (isAdmin() && resource.data.role != 'owner' && request.resource.data.role != 'owner')
                || (request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'disabled', 'permissions']));
      allow delete: if isAdmin() && resource.data.role != 'owner';
    }
    
    match /appSettings/{settingsId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }
    
    match /categories/{docId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }
    
    // BUG-P0-3: non-admin users may never change product prices directly.
    match /products/{docId} {
      allow read: if isActiveUser();
      allow create: if isStaff()
        && request.resource.data.quantity >= 0;
      allow update: if isStaff()
        && request.resource.data.quantity >= 0
        && (
          isAdmin()
          ||
          (!('price' in request.resource.data.diff(resource.data).affectedKeys())
            && !('retailCashPrice' in request.resource.data.diff(resource.data).affectedKeys())
            && !('retailCreditPrice' in request.resource.data.diff(resource.data).affectedKeys())
            && !('wholesaleCashPrice' in request.resource.data.diff(resource.data).affectedKeys())
            && !('wholesaleCreditPrice' in request.resource.data.diff(resource.data).affectedKeys()))
        );
      allow delete: if isAdmin();
    }
    
    // REQ-SEC1-8 Phase 0: openingBalance freeze — R1: isStaff() instead of isActiveUser() for non-admin path
    match /customers/{docId} {
      allow read: if isActiveUser();
      allow create: if isStaff();
      allow update: if isAdmin() || (isStaff()
        && !('openingBalance' in request.resource.data.diff(resource.data).affectedKeys()));
      allow delete: if isAdmin();
    }
    
    match /invoices/{docId} {
      allow read: if isActiveUser();
      allow create: if isStaff()
        && request.resource.data.total >= 0;
      allow update: if isAdmin()
        && request.resource.data.total >= 0;
      allow delete: if isAdmin();
    }
    
    match /returns/{docId} {
      allow read: if isActiveUser();
      allow create: if isStaff()
        && request.resource.data.total >= 0;
      allow update: if isAdmin()
        && request.resource.data.total >= 0;
      allow delete: if isAdmin();
    }
    
    match /customerPayments/{docId} {
      allow read: if isActiveUser();
      allow create: if isStaff()
        && request.resource.data.amount > 0;
      allow update: if isAdmin()
        && request.resource.data.amount > 0;
      allow delete: if isAdmin();
    }

    match /suppliers/{docId} {
      allow read: if isActiveUser();
      allow create: if isStaff();
      allow update: if isAdmin() || (isStaff()
        && !('openingBalance' in request.resource.data.diff(resource.data).affectedKeys()));
      allow delete: if isAdmin();
    }

    match /supplierPayments/{docId} {
      allow read: if isActiveUser();
      allow create: if isStaff()
        && request.resource.data.amount > 0;
      allow update: if isAdmin()
        && request.resource.data.amount > 0;
      allow delete: if isAdmin();
    }

    match /purchaseInvoices/{docId} {
      allow read: if isActiveUser();
      allow create: if isStaff()
        && request.resource.data.total >= 0;
      allow update: if isAdmin()
        && request.resource.data.total >= 0;
      allow delete: if isAdmin();
    }

    match /supplierReturns/{docId} {
      allow read: if isActiveUser();
      allow create: if isStaff()
        && request.resource.data.total >= 0;
      allow update: if isAdmin()
        && request.resource.data.total >= 0;
      allow delete: if isAdmin();
    }
    
    match /dailyArchives/{docId} {
      allow read: if isActiveUser();
      allow create: if canOpenDay();
      allow update: if (isStaff() && resource.data.status == 'open'
                    && !('status' in request.resource.data.diff(resource.data).affectedKeys()))
                || isAdmin();
      allow delete: if isAdmin();
    }

    // BUG-P0-13/15: counters — R1: isStaff() for non-admin path (was isActiveUser)
    match /counters/{docId} {
      allow read: if isActiveUser();
      allow create: if isAdmin() || (isStaff()
        && request.resource.data.lastNumber == 1
        && request.resource.data.keys().hasOnly(['lastNumber']));
      allow update: if isAdmin() || (isStaff()
        && request.resource.data.lastNumber == resource.data.lastNumber + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastNumber']));
      allow delete: if isAdmin();
    }

    // 2.2-free: clientErrors — unchanged (isActiveUser for create, isAdmin for read/delete)
    match /clientErrors/{docId} {
      allow create: if isActiveUser()
        && request.resource.data.keys().hasAll(['message', 'createdAt'])
        && request.resource.data.keys().hasOnly(['message', 'stack', 'source', 'url', 'createdAt', 'uid'])
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000
        && request.resource.data.createdAt is number
        && (!('stack' in request.resource.data) || (request.resource.data.stack is string
          && request.resource.data.stack.size() <= 2000))
        && (!('source' in request.resource.data) || (request.resource.data.source is string
          && request.resource.data.source.size() <= 100))
        && (!('url' in request.resource.data) || (request.resource.data.url is string
          && request.resource.data.url.size() <= 500))
        && (!('uid' in request.resource.data) || (request.resource.data.uid is string
          && request.resource.data.uid.size() <= 128));
      allow read, delete: if isAdmin();
    }
  }
}
