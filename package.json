{
  "name": "casher-yasoo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:android": "tsc && vite build --mode capacitor",
    "preview": "vite preview",
    "postinstall": "node scripts/copy-zxing-wasm.mjs",
    "test:rules": "firebase emulators:exec --only firestore,auth \"npx vitest run --fileParallelism=false\"",
    "test:e2e": "firebase emulators:exec --only firestore,auth \"npx playwright test\"",
    "test:e2e:seed-check": "firebase emulators:exec --only firestore,auth \"npx playwright test --list\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "android:build": "npm run build:android && npx cap sync && cd android && gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/keyboard": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "barcode-detector": "^3.2.2",
    "exceljs": "^4.4.0",
    "firebase": "^10.11.0",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.372.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.22.3",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.0.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@playwright/test": "^1.55.0",
    "@types/node": "^20.12.7",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-admin": "^14.4.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "terser": "^5.44.1",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.2.9",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^2.1.9"
  }
}
