rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return isAuthenticated() && (!('disabled' in getUserData()) || getUserData().disabled != true);
    }

    function isAdmin() {
      return isActiveUser() && getUserData().role == 'admin';
    }
    
    match /users/{userId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      // Only admins can change role or disabled fields. A user can update their own non-sensitive fields.
      allow update: if isAdmin() || (request.auth.uid == userId
                       && !('role' in request.resource.data.diff(resource.data).affectedKeys())
                       && !('disabled' in request.resource.data.diff(resource.data).affectedKeys()));
      allow create, delete: if isAdmin();
    }
    
    match /appSettings/{settingsId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }
    
    match /categories/{docId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }
    
    // BUG-P0-3: non-admin users may never change product prices directly.
    // App transaction paths (processSale/processPurchase/processReturn in
    // services/api.ts) write quantity only, so freezing price fields for
    // cashiers breaks nothing legitimate. create is split from update on
    // purpose: diff() needs an existing doc (resource.data), so a first-time
    // create carries no price check at all (there is no "old price").
    match /products/{docId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser()
        && request.resource.data.quantity >= 0;
      allow update: if isActiveUser()
        && request.resource.data.quantity >= 0
        && (
          isAdmin()
          ||
          // Cashier: every price field must stay untouched.
          (!('price' in request.resource.data.diff(resource.data).affectedKeys())
            && !('retailCashPrice' in request.resource.data.diff(resource.data).affectedKeys())
            && !('retailCreditPrice' in request.resource.data.diff(resource.data).affectedKeys())
            && !('wholesaleCashPrice' in request.resource.data.diff(resource.data).affectedKeys())
            && !('wholesaleCreditPrice' in request.resource.data.diff(resource.data).affectedKeys()))
        );
      allow delete: if isAdmin();
    }
    
    match /customers/{docId} {
      allow read, create, update: if isActiveUser();
      allow delete: if isAdmin();
    }
    
    match /invoices/{docId} {
      allow read, create, update: if isActiveUser();
      allow delete: if isAdmin();
    }
    
    match /returns/{docId} {
      allow read, create, update: if isActiveUser();
      allow delete: if isAdmin();
    }
    
    match /customerPayments/{docId} {
      allow read, create, update: if isActiveUser();
      allow delete: if isAdmin();
    }

    match /suppliers/{docId} {
      allow read, create, update: if isActiveUser();
      allow delete: if isAdmin();
    }

    match /supplierPayments/{docId} {
      allow read, create, update: if isActiveUser();
      allow delete: if isAdmin();
    }

    match /purchaseInvoices/{docId} {
      allow read, create, update: if isActiveUser();
      allow delete: if isAdmin();
    }

    match /supplierReturns/{docId} {
      allow read, create, update: if isActiveUser();
      allow delete: if isAdmin();
    }
    
    match /dailyArchives/{docId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser();
      allow update: if isActiveUser() && (
        !('status' in request.resource.data.diff(resource.data).affectedKeys())
        || resource.data.status != 'closed'
        || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // BUG-P0-13: counters may only ever advance by exactly +1 (atomic numbering).
    // Legitimate path (processSale/processPurchase in services/api.ts) reads
    // lastNumber inside a transaction and writes lastNumber+1 — or creates the
    // doc with lastNumber=1 on first use. Any direct write with an arbitrary
    // value (or delete by a non-admin) is denied.
    // Residual risk (documented, same style as docs/REQ-P0-2-baseline.md):
    // rules evaluate each write independently and cannot verify that a +1
    // happened "inside the same transaction that creates the invoice" — a
    // rogue client can still bump by +1 (numbering gaps only; never duplicates
    // or collisions, since numbering stays read-then-write in a retried
    // transaction). Owner decision pending on this note.
    match /counters/{docId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser()
        && request.resource.data.lastNumber == 1
        && request.resource.data.keys().hasOnly(['lastNumber']);
      allow update: if isActiveUser()
        && request.resource.data.lastNumber == resource.data.lastNumber + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastNumber']);
      allow delete: if isAdmin();
    }
  }
}
