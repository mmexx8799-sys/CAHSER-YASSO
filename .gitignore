# Local env with live credentials (NEVER commit — repro scripts read REPRO_* from here)
.env

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Android signing keystore (NEVER commit - contains signing credentials)
*.keystore
keystore.properties
android/app/release.keystore
android/casher-yasoo-release.keystore

# Firebase Admin service account key (NEVER commit - full project admin access)
*serviceAccountKey*.json
firebase-adminsdk-*.json

# Bundled archives (avoid bloating repo, may contain stale keystore)
*.zip

# Vite temp scaffold file (regenerated on every dev/build — must never be tracked)
vite.config.ts.timestamp-*.mjs

# Firebase CLI local cache (hosting deploy metadata)
.firebase/
