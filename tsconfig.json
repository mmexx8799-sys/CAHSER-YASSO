{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["./**/*.ts", "./**/*.tsx"],
  // e2e/ + playwright.config.ts: نوع مختلف (runner المتصفح) — Playwright
  // يفحص أنواعها وقت التشغيل (Stage-3 3.1). إبقاؤها هنا كان سيكسر
  // `tsc && vite build` لكل من لا يثبّت @playwright/test محليًا.
  "exclude": ["node_modules", "dist", "android", "e2e", "playwright.config.ts"]
}